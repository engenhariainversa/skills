# Qual API o app usa. `http` fala com EXPO_PUBLIC_API_URL; `mock` roda tudo em memória, sem rede
# (simulador sem backend, testes). Sem .env o código cai em `mock`.
EXPO_PUBLIC_API_MODE=http

# Backend em modo `http`. EXPO_PUBLIC_* é embutido no bundle: nunca coloque segredo aqui.
# No emulador Android, o host é 10.0.2.2; num aparelho físico, o IP da máquina na rede local.
EXPO_PUBLIC_API_URL=http://localhost:4050
