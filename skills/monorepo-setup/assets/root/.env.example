# ============================================================
# Defaults de DEV — seguros de commitar, usados pelo docker-compose.dev.yml
# Copie para .env se for rodar algo fora do compose de dev:  cp .env.example .env
# ============================================================

# Banco (bate com as credenciais do docker-compose.dev.yml)
POSTGRES_USER=<projeto>
POSTGRES_PASSWORD=<projeto>_dev
POSTGRES_DB=<projeto>
DATABASE_URL=postgresql://<projeto>:<projeto>_dev@localhost:5433/<projeto>

# Auth — NUNCA use este valor em produção
JWT_SECRET=dev-secret-change-in-production

# Frontend (embutido no build do Next)
NEXT_PUBLIC_API_URL=http://localhost:4050
NEXT_PUBLIC_GRAPHQL_PATH=/graphql

# ============================================================
# Produção
# ------------------------------------------------------------
# Nunca commitados. O GitHub Actions escreve /opt/<projeto>/.env a partir dos
# secrets do repositório antes do `docker compose up`.
#
# Secrets necessários:
#   POSTGRES_USER, POSTGRES_PASSWORD (forte, gerada), POSTGRES_DB
#   DATABASE_URL              (host = serviço `db` do compose)
#   JWT_SECRET                (openssl rand -hex 64)
#   NEXT_PUBLIC_API_URL       (host público da API, sem path)
#   NEXT_PUBLIC_GRAPHQL_PATH  (ex.: /graphql)
# ============================================================
